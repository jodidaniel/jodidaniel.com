# Per-site deploy parameters for the infrastructure/ and oauth-proxy/ stacks.
# Copy to site-params.env (gitignored), fill in the secrets, then before
# running any of the platform's deploy.sh scripts:
#   cp infrastructure/site-params.example.env infrastructure/site-params.env
#   # edit infrastructure/site-params.env with the real OAuth app id/secret
#   set -a; source infrastructure/site-params.env; set +a
# Only this .example template is committed; the filled site-params.env is
# gitignored so the GitHub OAuth client secret never lands in git.

# ── Required ────────────────────────────────────────────────────────────────
export GITHUB_REPO="jodidaniel.com"        # owner is GITHUB_ORG below
export APEX_DOMAIN="jodidaniel.com"         # production apex (no scheme)
# The platform deploy scripts' own default for GITHUB_ORG is "Adam-S-Daniel"
# (adamdaniel.ai's org) — WRONG for this repo. This site is org-owned by
# `jodidaniel`, so GITHUB_ORG MUST be set explicitly; do not unset/comment it.
export GITHUB_ORG="jodidaniel"

# ── OAuth proxy (oauth-proxy/deploy.sh) ──────────────────────────────────────
export GITHUB_CLIENT_ID="xxxxxxxxxxxxxxxx"
export GITHUB_CLIENT_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
export ALLOWED_ORIGINS="https://jodidaniel.com"
export STACK_NAME="jodidaniel-com-oauth-proxy"   # oauth-proxy stack/function name

# ── Optional (sensible defaults derive from APEX_DOMAIN) ─────────────────────
# export RESOURCE_PREFIX="jodidaniel-com"          # apex with dots->hyphens
# export AWS_REGION="us-east-1"
# export HOSTED_ZONE_ID="ZXXXXXXXXXXXXX"         # auto-detected from Route53 if unset

# ── Media archive (optional) ─────────────────────────────────────────────────
# Private S3 bucket holding archived media PDFs. Opt-in: the bootstrap template
# creates the bucket only when this is non-empty, so leaving it unset changes
# nothing. `scripts/media-archive.sh` defaults to this same name.
export MEDIA_ARCHIVE_BUCKET="jodidaniel-com-media-archive"

# Creating the bucket is an ordinary bootstrap stack UPDATE, run from a
# cms-platform checkout at platform.lock's platform_ref (this repo ships no
# bootstrap wrapper). All three overrides are load-bearing:
#   set -a; source infrastructure/site-params.env; set +a
#   STACK_NAME=jodidaniel-com-bootstrap \
#   CREATE_OIDC_PROVIDER=false \
#   CREATE_APEX_DNS_RECORDS=false \
#     bash /path/to/cms-platform/infrastructure/bootstrap/deploy.sh
#
# STACK_NAME — this file exports STACK_NAME for the OAuth-proxy deploy, and the
#   bootstrap script honours an inherited value, so sourcing this file without
#   the override aims the BOOTSTRAP template at the OAuth-proxy stack.
# CREATE_OIDC_PROVIDER — deploy.sh DEFAULTS THIS TO true, but this stack was
#   deployed with false: the account's GitHub OIDC provider already exists
#   (adamdaniel.ai created it) and only one per URL is allowed. Letting it
#   default re-adds the provider resource and the update fails.
# CREATE_APEX_DNS_RECORDS — deploy.sh defaults this to false, which is correct
#   here and must stay that way: this stack does NOT manage the apex records
#   (the jodidaniel.com A-alias was created outside it during the Squarespace
#   cutover). Setting it true would make CloudFormation try to create records
#   that already exist.
# deploy.sh re-sends EVERY parameter on each run — nothing uses
# UsePreviousValue — so any flag you omit silently reverts to its script
# default. Read the live values before deploying:
#   aws cloudformation describe-stacks --stack-name jodidaniel-com-bootstrap \
#     --region us-east-1 --query 'Stacks[0].Parameters' --output table
